{
  "manifest_version": 3,
  "name": "极简右键扫码打开",
  "version": "1.1",
  "description": "右键识别二维码，链接直接打开",
  "permissions": ["contextMenus", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "bg.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["jsQR.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
